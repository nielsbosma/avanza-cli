{
  "name": "avanza-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for Avanza: read holdings and place limit orders within limits a human sets.",
  "type": "module",
  "bin": {
    "avanza": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "avanza",
    "cli",
    "agent",
    "trading",
    "claude",
    "codex"
  ],
  "author": "Niels Bosma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielsbosma/avanza-cli.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@napi-rs/keyring": "^2.1.0",
    "commander": "^15.0.0",
    "otpauth": "^9.5.2",
    "tough-cookie": "^6.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
